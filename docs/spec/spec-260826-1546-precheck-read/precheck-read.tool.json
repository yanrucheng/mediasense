{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mediasense:tool:precheck-read",
  "name": "mediasense.precheck.read",
  "description": "Inspect or traverse one explicitly identified immutable PreCheck compression result without exposing internal storage or mutable working state.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:mediasense:tool:precheck-read-input",
    "type": "object",
    "additionalProperties": false,
    "required": ["result_ref", "action"],
    "properties": {
      "result_ref": {
        "type": "string",
        "minLength": 1,
        "description": "Opaque identity of the exact immutable result. It never means latest."
      },
      "action": {
        "enum": ["inspect", "traverse"]
      },
      "target": {
        "$ref": "#/$defs/target_ref"
      },
      "relation": {
        "$ref": "#/$defs/relation"
      },
      "direction": {
        "enum": ["outbound", "inbound"]
      },
      "filter": {
        "$ref": "#/$defs/filter"
      },
      "page": {
        "$ref": "#/$defs/page_request"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {"action": {"const": "inspect"}},
          "required": ["action"]
        },
        "then": {
          "properties": {
            "relation": false,
            "direction": false,
            "filter": false,
            "page": false
          }
        }
      },
      {
        "if": {
          "properties": {"action": {"const": "traverse"}},
          "required": ["action"]
        },
        "then": {
          "required": ["relation", "direction"]
        }
      },
      {
        "if": {"required": ["filter"]},
        "then": {
          "properties": {
            "relation": {"const": "accounts_for"},
            "direction": {"const": "outbound"}
          },
          "required": ["relation", "direction"]
        }
      },
      {
        "if": {
          "properties": {"action": {"const": "traverse"}},
          "required": ["action"]
        },
        "then": {
          "oneOf": [
            {
              "properties": {
                "relation": {"const": "accounts_for"},
                "direction": {"const": "outbound"},
                "target": false
              },
              "required": ["relation", "direction"]
            },
            {
              "properties": {
                "relation": {"const": "accounts_for"},
                "direction": {"const": "inbound"},
                "target": {"$ref": "#/$defs/source_item_ref"}
              },
              "required": ["relation", "direction", "target"]
            },
            {
              "properties": {
                "relation": {"const": "entry_evidence"},
                "direction": {"const": "outbound"},
                "target": false
              },
              "required": ["relation", "direction"]
            },
            {
              "properties": {
                "relation": {"const": "entry_evidence"},
                "direction": {"const": "inbound"},
                "target": {"$ref": "#/$defs/evidence_ref"}
              },
              "required": ["relation", "direction", "target"]
            },
            {
              "properties": {
                "relation": {"const": "represents"},
                "direction": {"const": "outbound"},
                "target": {"$ref": "#/$defs/evidence_ref"}
              },
              "required": ["relation", "direction", "target"]
            },
            {
              "properties": {
                "relation": {"const": "represents"},
                "direction": {"const": "inbound"},
                "target": {"$ref": "#/$defs/source_item_ref"}
              },
              "required": ["relation", "direction", "target"]
            },
            {
              "properties": {
                "relation": {"enum": ["derived_from", "expands_to"]},
                "direction": {"const": "outbound"},
                "target": {"$ref": "#/$defs/evidence_ref"}
              },
              "required": ["relation", "direction", "target"]
            },
            {
              "properties": {
                "relation": {"enum": ["derived_from", "expands_to"]},
                "direction": {"const": "inbound"},
                "target": {
                  "oneOf": [
                    {"$ref": "#/$defs/source_item_ref"},
                    {"$ref": "#/$defs/evidence_ref"}
                  ]
                }
              },
              "required": ["relation", "direction", "target"]
            }
          ]
        }
      }
    ],
    "$defs": {
      "dataset_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"const": "dataset"},
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "source_item_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"const": "source_item"},
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "evidence_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"const": "evidence"},
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "target_ref": {
        "oneOf": [
          {"$ref": "#/$defs/dataset_ref"},
          {"$ref": "#/$defs/source_item_ref"},
          {"$ref": "#/$defs/evidence_ref"}
        ]
      },
      "relation": {
        "enum": [
          "accounts_for",
          "entry_evidence",
          "represents",
          "derived_from",
          "expands_to"
        ]
      },
      "filter": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attention_only"],
        "properties": {
          "attention_only": {
            "const": true,
            "description": "Derived view over accounts_for; selects members with a non-usable condition or material qualification."
          }
        }
      },
      "page_request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 100
          },
          "cursor": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:mediasense:tool:precheck-read-output",
    "oneOf": [
      {"$ref": "#/$defs/inspect_response"},
      {"$ref": "#/$defs/traverse_response"},
      {"$ref": "#/$defs/error_response"}
    ],
    "$defs": {
      "json_value": {
        "description": "A JSON value whose domain meaning is named by its containing record.",
        "oneOf": [
          {"type": "boolean"},
          {"type": "number"},
          {"type": "string"},
          {"type": "array"},
          {"type": "object"}
        ]
      },
      "result_target_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"const": "result"},
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "dataset_target_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"const": "dataset"},
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "source_item_target_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"const": "source_item"},
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "evidence_target_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"const": "evidence"},
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "target_ref": {
        "oneOf": [
          {"$ref": "#/$defs/result_target_ref"},
          {"$ref": "#/$defs/dataset_target_ref"},
          {"$ref": "#/$defs/source_item_target_ref"},
          {"$ref": "#/$defs/evidence_target_ref"}
        ]
      },
      "relation": {
        "enum": [
          "accounts_for",
          "entry_evidence",
          "represents",
          "derived_from",
          "expands_to"
        ]
      },
      "basis": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary"],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "refs": {
                "type": "array",
                "items": {"$ref": "#/$defs/target_ref"}
              }
            }
          }
        ]
      },
      "qualification": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "effect", "message"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "enum": ["informational", "limits_interpretation", "blocks_use"]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "$ref": "#/$defs/basis"
          }
        }
      },
      "observation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["available", "missing", "failed", "not_checked", "not_applicable"]
          },
          "value": {
            "$ref": "#/$defs/json_value"
          },
          "basis": {
            "$ref": "#/$defs/basis"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "qualifications": {
            "type": "array",
            "items": {"$ref": "#/$defs/qualification"}
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"status": {"const": "available"}},
              "required": ["status"]
            },
            "then": {
              "properties": {
                "value": true,
                "basis": true
              },
              "required": ["value", "basis"]
            }
          },
          {
            "if": {
              "properties": {"status": {"const": "failed"}},
              "required": ["status"]
            },
            "then": {
              "properties": {
                "basis": true,
                "value": false
              },
              "required": ["basis"]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": ["missing", "not_checked", "not_applicable"]
                }
              },
              "required": ["status"]
            },
            "then": {
              "properties": {"value": false}
            }
          }
        ]
      },
      "locator": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "access": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "locator"],
            "properties": {
              "kind": {"const": "local_artifact"},
              "locator": {"$ref": "#/$defs/locator"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "source_item_ref"],
            "properties": {
              "kind": {"const": "source_item"},
              "source_item_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": {
              "kind": {"const": "inline"},
              "value": {"$ref": "#/$defs/json_value"}
            }
          }
        ]
      },
      "context_entry": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content", "provided_by"],
        "properties": {
          "content": {"$ref": "#/$defs/json_value"},
          "provided_by": {
            "type": "string",
            "minLength": 1
          },
          "qualifications": {
            "type": "array",
            "items": {"$ref": "#/$defs/qualification"}
          }
        }
      },
      "result_view": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "dataset_ref", "coverage", "readiness", "integrity"],
        "properties": {
          "kind": {"const": "result"},
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "dataset_ref": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "enum": ["complete", "partial"]
          },
          "readiness": {
            "enum": ["plan_ready", "blocked"]
          },
          "integrity": {
            "enum": ["valid", "invalid"]
          },
          "qualifications": {
            "type": "array",
            "items": {"$ref": "#/$defs/qualification"}
          }
        }
      },
      "dataset_view": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"const": "dataset"},
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "array",
            "items": {"$ref": "#/$defs/context_entry"}
          },
          "qualifications": {
            "type": "array",
            "items": {"$ref": "#/$defs/qualification"}
          }
        }
      },
      "source_item_view": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "locator"],
        "properties": {
          "kind": {"const": "source_item"},
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "locator": {"$ref": "#/$defs/locator"},
          "observations": {
            "type": "array",
            "items": {"$ref": "#/$defs/observation"}
          },
          "qualifications": {
            "type": "array",
            "items": {"$ref": "#/$defs/qualification"}
          }
        }
      },
      "evidence_view": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "access"],
        "properties": {
          "kind": {"const": "evidence"},
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "access": {"$ref": "#/$defs/access"},
          "observations": {
            "type": "array",
            "items": {"$ref": "#/$defs/observation"}
          },
          "qualifications": {
            "type": "array",
            "items": {"$ref": "#/$defs/qualification"}
          }
        }
      },
      "object_view": {
        "oneOf": [
          {"$ref": "#/$defs/result_view"},
          {"$ref": "#/$defs/dataset_view"},
          {"$ref": "#/$defs/source_item_view"},
          {"$ref": "#/$defs/evidence_view"}
        ]
      },
      "relationship_member": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target"],
        "properties": {
          "target": {"$ref": "#/$defs/target_ref"},
          "scope": {
            "enum": ["source_media", "auxiliary", "excluded"]
          },
          "condition": {
            "enum": ["usable", "unsupported", "invalid", "error", "unresolved"]
          },
          "basis": {"$ref": "#/$defs/basis"},
          "qualifications": {
            "type": "array",
            "items": {"$ref": "#/$defs/qualification"}
          }
        }
      },
      "page": {
        "type": "object",
        "additionalProperties": false,
        "required": ["returned", "complete"],
        "properties": {
          "returned": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "complete": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"complete": {"const": false}},
              "required": ["complete"]
            },
            "then": {
              "properties": {"next_cursor": true},
              "required": ["next_cursor"]
            },
            "else": {
              "properties": {"next_cursor": false}
            }
          }
        ]
      },
      "inspect_response": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome", "result_ref", "action", "target"],
        "properties": {
          "outcome": {"const": "ok"},
          "result_ref": {
            "type": "string",
            "minLength": 1
          },
          "action": {"const": "inspect"},
          "target": {"$ref": "#/$defs/object_view"}
        }
      },
      "traverse_response": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome", "result_ref", "action", "origin", "relation", "direction", "items", "page"],
        "properties": {
          "outcome": {"const": "ok"},
          "result_ref": {
            "type": "string",
            "minLength": 1
          },
          "action": {"const": "traverse"},
          "origin": {"$ref": "#/$defs/target_ref"},
          "relation": {"$ref": "#/$defs/relation"},
          "direction": {
            "enum": ["outbound", "inbound"]
          },
          "derived_view": {
            "const": "attention_items"
          },
          "basis": {"$ref": "#/$defs/basis"},
          "qualifications": {
            "type": "array",
            "items": {"$ref": "#/$defs/qualification"}
          },
          "items": {
            "type": "array",
            "items": {"$ref": "#/$defs/relationship_member"}
          },
          "page": {"$ref": "#/$defs/page"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"relation": {"const": "accounts_for"}},
              "required": ["relation"]
            },
            "then": {
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "scope": true,
                      "condition": true
                    },
                    "required": ["scope", "condition"]
                  }
                }
              }
            },
            "else": {
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "scope": false,
                      "condition": false
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {"relation": {"const": "represents"}},
              "required": ["relation"]
            },
            "then": {
              "anyOf": [
                {
                  "properties": {"basis": true},
                  "required": ["basis"]
                },
                {
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {"basis": true},
                        "required": ["basis"]
                      }
                    }
                  }
                }
              ]
            }
          },
          {
            "oneOf": [
              {
                "properties": {
                  "relation": {"const": "accounts_for"},
                  "direction": {"const": "outbound"},
                  "origin": {"$ref": "#/$defs/result_target_ref"},
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "target": {"$ref": "#/$defs/source_item_target_ref"}
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "relation": {"const": "accounts_for"},
                  "direction": {"const": "inbound"},
                  "origin": {"$ref": "#/$defs/source_item_target_ref"},
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "target": {"$ref": "#/$defs/result_target_ref"}
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "relation": {"const": "entry_evidence"},
                  "direction": {"const": "outbound"},
                  "origin": {"$ref": "#/$defs/result_target_ref"},
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "target": {"$ref": "#/$defs/evidence_target_ref"}
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "relation": {"const": "entry_evidence"},
                  "direction": {"const": "inbound"},
                  "origin": {"$ref": "#/$defs/evidence_target_ref"},
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "target": {"$ref": "#/$defs/result_target_ref"}
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "relation": {"const": "represents"},
                  "direction": {"const": "outbound"},
                  "origin": {"$ref": "#/$defs/evidence_target_ref"},
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "target": {"$ref": "#/$defs/source_item_target_ref"}
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "relation": {"const": "represents"},
                  "direction": {"const": "inbound"},
                  "origin": {"$ref": "#/$defs/source_item_target_ref"},
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "target": {"$ref": "#/$defs/evidence_target_ref"}
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "relation": {"enum": ["derived_from", "expands_to"]},
                  "direction": {"const": "outbound"},
                  "origin": {"$ref": "#/$defs/evidence_target_ref"},
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "target": {
                          "oneOf": [
                            {"$ref": "#/$defs/source_item_target_ref"},
                            {"$ref": "#/$defs/evidence_target_ref"}
                          ]
                        }
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "relation": {"enum": ["derived_from", "expands_to"]},
                  "direction": {"const": "inbound"},
                  "origin": {
                    "oneOf": [
                      {"$ref": "#/$defs/source_item_target_ref"},
                      {"$ref": "#/$defs/evidence_target_ref"}
                    ]
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "target": {"$ref": "#/$defs/evidence_target_ref"}
                      }
                    }
                  }
                }
              }
            ]
          },
          {
            "if": {
              "properties": {"derived_view": true},
              "required": ["derived_view"]
            },
            "then": {
              "properties": {
                "relation": {"const": "accounts_for"},
                "direction": {"const": "outbound"},
                "origin": {"$ref": "#/$defs/result_target_ref"}
              }
            }
          }
        ]
      },
      "error_response": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome", "result_ref", "error"],
        "properties": {
          "outcome": {"const": "error"},
          "result_ref": {
            "type": "string",
            "minLength": 1
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {
                "enum": [
                  "result_not_found",
                  "result_not_available",
                  "result_untrusted",
                  "target_not_found",
                  "foreign_reference",
                  "relation_not_applicable",
                  "invalid_filter",
                  "invalid_cursor",
                  "access_failed"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "qualifications": {
                "type": "array",
                "items": {"$ref": "#/$defs/qualification"}
              }
            }
          }
        }
      }
    }
  }
}
