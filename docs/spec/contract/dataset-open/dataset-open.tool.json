{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mediasense:tool:dataset-open",
  "name": "mediasense.dataset.open",
  "description": "Resolve or create one exact MediaSense Dataset workspace without reading or modifying source media.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "source_root"
    ],
    "properties": {
      "source_root": {
        "type": "string",
        "minLength": 1
      },
      "workspace": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "outputSchema": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome",
          "dataset_ref",
          "source_root",
          "workspace",
          "selection_tier",
          "created",
          "manifest_version",
          "store_versions",
          "configuration",
          "warnings"
        ],
        "properties": {
          "outcome": {
            "const": "ok"
          },
          "dataset_ref": {
            "type": "string",
            "pattern": "^dataset:[^\\s]+$"
          },
          "source_root": {
            "type": "string",
            "minLength": 1
          },
          "workspace": {
            "type": "string",
            "minLength": 1
          },
          "selection_tier": {
            "enum": [
              "explicit",
              "external_volume",
              "local"
            ]
          },
          "created": {
            "type": "boolean"
          },
          "manifest_version": {
            "type": "integer",
            "minimum": 1
          },
          "store_versions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "precheck",
              "plan",
              "geo",
              "apply"
            ],
            "properties": {
              "precheck": {
                "type": "integer",
                "minimum": 1
              },
              "plan": {
                "type": "integer",
                "minimum": 1
              },
              "geo": {
                "type": "integer",
                "minimum": 1
              },
              "apply": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "configuration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sources",
              "providers",
              "metadata"
            ],
            "properties": {
              "metadata": {
                "$ref": "#/$defs/metadata_configuration"
              },
              "geo_network": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "identity",
                  "proxy_receivers",
                  "no_proxy_configured",
                  "ca_source",
                  "reachability",
                  "tls_verification"
                ],
                "properties": {
                  "identity": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "proxy_receivers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "no_proxy_configured": {
                    "type": "boolean"
                  },
                  "ca_source": {
                    "enum": [
                      "system",
                      "configured_bundle"
                    ]
                  },
                  "reachability": {
                    "const": "not_checked"
                  },
                  "tls_verification": {
                    "const": true
                  }
                }
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "local_embedding": {
                "description": "Local encoder configuration, not proof of execution. Run Work and sealed Result context report execution/reuse/failure.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "reason",
                  "profile",
                  "execution",
                  "model_downloads"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "disabled",
                      "configured"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "profile": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "execution": {
                    "const": "not_checked"
                  },
                  "model_downloads": {
                    "const": false
                  }
                }
              },
              "providers": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "amap",
                  "google_maps"
                ],
                "properties": {
                  "amap": {
                    "$ref": "#/$defs/provider_status"
                  },
                  "google_maps": {
                    "$ref": "#/$defs/provider_status"
                  }
                }
              },
              "local_sensitivity": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "configuration",
                  "error",
                  "execution",
                  "model_downloads"
                ],
                "properties": {
                  "configuration": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "error": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "execution": {
                    "const": "not_checked"
                  },
                  "model_downloads": {
                    "const": false
                  }
                }
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome",
          "error"
        ],
        "properties": {
          "outcome": {
            "const": "error"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    ],
    "$defs": {
      "metadata_configuration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumed_timezone",
          "output_timezone",
          "manufacturer_knowledge"
        ],
        "properties": {
          "assumed_timezone": {
            "type": "string",
            "minLength": 1
          },
          "output_timezone": {
            "type": "string",
            "minLength": 1
          },
          "manufacturer_knowledge": {
            "$ref": "#/$defs/manufacturer_knowledge"
          }
        }
      },
      "manufacturer_origin": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer",
          "file",
          "document_identity"
        ],
        "properties": {
          "layer": {
            "enum": [
              "builtin",
              "user"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "document_identity": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "manufacturer_knowledge": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identity",
              "sources",
              "active_rules",
              "disabled_rules",
              "execution",
              "overridden_rules"
            ],
            "properties": {
              "identity": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/manufacturer_origin"
                }
              },
              "active_rules": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "disabled_rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "reason",
                    "origin",
                    "replaces"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "origin": {
                      "$ref": "#/$defs/manufacturer_origin"
                    },
                    "replaces": {
                      "$ref": "#/$defs/manufacturer_origin"
                    }
                  }
                }
              },
              "execution": {
                "const": "not_checked"
              },
              "overridden_rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "origin",
                    "replaces"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "origin": {
                      "$ref": "#/$defs/manufacturer_origin"
                    },
                    "replaces": {
                      "$ref": "#/$defs/manufacturer_origin"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "error",
              "execution"
            ],
            "properties": {
              "execution": {
                "const": "not_checked"
              },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "const": "configuration_invalid"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      },
      "provider_status": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "credential",
          "capability",
          "data_handling"
        ],
        "properties": {
          "credential": {
            "enum": [
              "configured",
              "not_configured"
            ]
          },
          "capability": {
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "data_handling": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
