{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "mediasense.precheck.run",
  "description": "控制一次 PreCheck 或只读观察其状态；外部效果必须另行可信确认。",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "dataset_ref",
          "request_id"
        ],
        "properties": {
          "action": {
            "const": "start"
          },
          "dataset_ref": {
            "$ref": "#/$defs/dataset_ref"
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "prior_result_ref": {
            "$ref": "#/$defs/result_ref"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "dataset_ref",
          "run_ref"
        ],
        "properties": {
          "action": {
            "const": "status"
          },
          "dataset_ref": {
            "$ref": "#/$defs/dataset_ref"
          },
          "run_ref": {
            "$ref": "#/$defs/run_ref"
          },
          "include": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "enum": [
                "accounting",
                "diagnostics",
                "confirmation"
              ]
            }
          },
          "page": {
            "$ref": "#/$defs/page_request"
          },
          "scope_path": {
            "type": "string",
            "minLength": 1
          },
          "scope_after": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependentRequired": {
          "scope_after": [
            "scope_path"
          ]
        },
        "allOf": [
          {
            "if": {
              "required": [
                "page"
              ]
            },
            "then": {
              "required": [
                "include"
              ],
              "properties": {
                "include": {
                  "contains": {
                    "enum": [
                      "diagnostics",
                      "confirmation"
                    ]
                  }
                }
              }
            }
          },
          {
            "not": {
              "properties": {
                "include": {
                  "allOf": [
                    {
                      "contains": {
                        "const": "diagnostics"
                      }
                    },
                    {
                      "contains": {
                        "const": "confirmation"
                      }
                    }
                  ]
                }
              },
              "required": [
                "include"
              ]
            }
          },
          {
            "if": {
              "required": [
                "scope_path"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "page"
                    ]
                  },
                  {
                    "required": [
                      "include"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "dataset_ref",
          "run_ref"
        ],
        "properties": {
          "action": {
            "const": "pause"
          },
          "dataset_ref": {
            "$ref": "#/$defs/dataset_ref"
          },
          "run_ref": {
            "$ref": "#/$defs/run_ref"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "dataset_ref",
          "run_ref"
        ],
        "properties": {
          "action": {
            "const": "resume"
          },
          "dataset_ref": {
            "$ref": "#/$defs/dataset_ref"
          },
          "run_ref": {
            "$ref": "#/$defs/run_ref"
          },
          "decision": {
            "oneOf": [
              {
                "enum": [
                  "proceed",
                  "decline"
                ]
              },
              {
                "$ref": "#/$defs/selection"
              }
            ]
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "dataset_ref",
          "run_ref"
        ],
        "properties": {
          "action": {
            "const": "cancel"
          },
          "dataset_ref": {
            "$ref": "#/$defs/dataset_ref"
          },
          "run_ref": {
            "$ref": "#/$defs/run_ref"
          }
        }
      }
    ],
    "$defs": {
      "dataset_ref": {
        "type": "string",
        "pattern": "^dataset:[^\\s]+$"
      },
      "run_ref": {
        "type": "string",
        "pattern": "^precheck-run:[^\\s]+$"
      },
      "result_ref": {
        "type": "string",
        "pattern": "^precheck-result:[^\\s]+$"
      },
      "page_request": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "cursor": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "selection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "inventory_fingerprint",
          "default_disposition",
          "exceptions"
        ],
        "properties": {
          "kind": {
            "const": "source_scope"
          },
          "inventory_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "default_disposition": {
            "enum": [
              "include",
              "exclude"
            ]
          },
          "exceptions": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "$ref": "#/$defs/error_response"
      },
      {
        "$ref": "#/$defs/started"
      },
      {
        "$ref": "#/$defs/control"
      },
      {
        "$ref": "#/$defs/running"
      },
      {
        "$ref": "#/$defs/paused"
      },
      {
        "$ref": "#/$defs/blocked"
      },
      {
        "$ref": "#/$defs/completed"
      },
      {
        "$ref": "#/$defs/failed"
      },
      {
        "$ref": "#/$defs/cancelled"
      }
    ],
    "$defs": {
      "run_ref": {
        "type": "string",
        "pattern": "^precheck-run:[^\\s]+$"
      },
      "result_ref": {
        "type": "string",
        "pattern": "^precheck-result:[^\\s]+$"
      },
      "identity": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "state": {
        "enum": [
          "running",
          "paused",
          "blocked",
          "completed",
          "cancelled",
          "failed"
        ]
      },
      "phase": {
        "enum": [
          "source_accounting",
          "scope_review",
          "metadata",
          "renditions",
          "video",
          "gpx",
          "embeddings",
          "sensitivity",
          "bundling",
          "compression",
          "geo",
          "publishing",
          "complete",
          "unknown"
        ]
      },
      "controls": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "pause",
            "resume",
            "cancel"
          ]
        },
        "minItems": 1
      },
      "reason": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "resume_when": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "qualification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "effect",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "enum": [
              "limits_interpretation",
              "blocks_use"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "$ref": "#/$defs/basis"
          }
        }
      },
      "basis": {
        "$ref": "#/$defs/json_value"
      },
      "json_value": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/json_value"
            }
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/json_value"
            }
          }
        ]
      },
      "issue": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "code",
          "unit",
          "count",
          "message"
        ],
        "properties": {
          "phase": {
            "$ref": "#/$defs/phase"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "qualifications": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/qualification"
        }
      },
      "error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "diagnostic_id": {
            "type": "string",
            "minLength": 1
          },
          "run_ref": {
            "$ref": "#/$defs/run_ref"
          },
          "current_state": {
            "$ref": "#/$defs/state"
          },
          "allowed_actions": {
            "$ref": "#/$defs/controls"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          }
        }
      },
      "error_response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/$defs/error"
          }
        }
      },
      "page": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "total",
          "next_cursor"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "stop_reason": {
            "const": "byte_limit"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "next_cursor": {
                  "type": "null"
                }
              },
              "required": [
                "next_cursor"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "stop_reason"
                ]
              }
            }
          }
        ]
      },
      "progress": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "unit",
          "processed",
          "total",
          "last_progress_at"
        ],
        "properties": {
          "phase": {
            "$ref": "#/$defs/phase"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "processed": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "total": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "last_progress_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "coverage",
          "readiness"
        ],
        "properties": {
          "ref": {
            "$ref": "#/$defs/result_ref"
          },
          "coverage": {
            "enum": [
              "complete",
              "partial"
            ]
          },
          "readiness": {
            "enum": [
              "plan_ready",
              "blocked"
            ]
          },
          "qualifications": {
            "$ref": "#/$defs/qualifications"
          }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "properties": {
                    "coverage": {
                      "const": "partial"
                    }
                  },
                  "required": [
                    "coverage"
                  ]
                },
                {
                  "properties": {
                    "readiness": {
                      "const": "blocked"
                    }
                  },
                  "required": [
                    "readiness"
                  ]
                }
              ]
            },
            "then": {
              "required": [
                "qualifications"
              ]
            }
          }
        ]
      },
      "accepted_selection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "inventory_fingerprint",
          "default_disposition",
          "exceptions",
          "provenance"
        ],
        "properties": {
          "kind": {
            "const": "source_scope"
          },
          "inventory_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "default_disposition": {
            "enum": [
              "include",
              "exclude"
            ]
          },
          "exceptions": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "provenance": {
            "enum": [
              "accepted",
              "reused"
            ]
          },
          "reused_from_run_ref": {
            "$ref": "#/$defs/run_ref"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "provenance": {
                  "const": "reused"
                }
              },
              "required": [
                "provenance"
              ]
            },
            "then": {
              "required": [
                "reused_from_run_ref"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "reused_from_run_ref"
                ]
              }
            }
          }
        ]
      },
      "execution_boundary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_read_only",
          "remote_models",
          "logical_external_queries",
          "historical_provider_requests",
          "current_provider_requests",
          "billable_calls",
          "transmitted_data_classes",
          "providers_attempted"
        ],
        "properties": {
          "source_read_only": {
            "const": true
          },
          "remote_models": {
            "type": "boolean"
          },
          "logical_external_queries": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "historical_provider_requests": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "current_provider_requests": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "billable_calls": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "transmitted_data_classes": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "providers_attempted": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "qualifications": {
            "$ref": "#/$defs/qualifications"
          }
        }
      },
      "accounting_run": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "discovered",
          "accounted",
          "scope_condition"
        ],
        "properties": {
          "discovered": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "accounted": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "scope_condition": {
            "anyOf": [
              {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "scope",
                    "condition",
                    "count"
                  ],
                  "properties": {
                    "scope": {
                      "enum": [
                        "source_media",
                        "auxiliary",
                        "excluded"
                      ]
                    },
                    "condition": {
                      "enum": [
                        "usable",
                        "unsupported",
                        "invalid",
                        "error",
                        "unresolved"
                      ]
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "selection": {
            "$ref": "#/$defs/accepted_selection"
          }
        }
      },
      "diagnostic_work": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "unit",
          "completed",
          "reused",
          "failed",
          "remaining",
          "total"
        ],
        "properties": {
          "phase": {
            "$ref": "#/$defs/phase"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "completed": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "reused": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "failed": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "remaining": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "total": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "diagnostics": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "work",
          "issues",
          "page"
        ],
        "properties": {
          "work": {
            "$ref": "#/$defs/diagnostic_work"
          },
          "issues": {
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "#/$defs/issue"
            }
          },
          "page": {
            "$ref": "#/$defs/page"
          },
          "execution_boundary": {
            "$ref": "#/$defs/execution_boundary"
          }
        }
      },
      "scope_entry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "node_type",
          "file_count",
          "byte_count",
          "unknown_size_count",
          "kind_counts",
          "size_buckets",
          "representative_paths",
          "child_count"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "node_type": {
            "enum": [
              "directory",
              "file"
            ]
          },
          "file_count": {
            "type": "integer",
            "minimum": 0
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0
          },
          "unknown_size_count": {
            "type": "integer",
            "minimum": 0
          },
          "kind_counts": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "count"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "size_buckets": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bucket",
                "count"
              ],
              "properties": {
                "bucket": {
                  "enum": [
                    "unknown",
                    "zero",
                    "under_1_mib",
                    "1_to_10_mib",
                    "10_to_100_mib",
                    "100_mib_or_more"
                  ]
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "representative_paths": {
            "description": "Only the path of a file entry at the requested level; empty for directories. Descendant names require explicit scope_path navigation.",
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 3
          },
          "child_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "scope_inventory": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "complete",
          "view"
        ],
        "properties": {
          "complete": {
            "type": "boolean"
          },
          "view": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "entries",
              "next_after"
            ],
            "properties": {
              "root": {
                "type": "string",
                "minLength": 1
              },
              "entries": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "$ref": "#/$defs/scope_entry"
                },
                "maxItems": 63
              },
              "next_after": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "issues": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "code",
                "message"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "issues_truncated": {
            "const": true
          }
        }
      },
      "coordinate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "latitude",
          "longitude",
          "datum"
        ],
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "datum": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "disclosure": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "geo_request_fingerprint",
          "operation",
          "coordinates",
          "pending_logical_queries",
          "source_item_outcomes",
          "nearby_radius_meters",
          "max_places",
          "transmitted_data_classes",
          "providers",
          "max_provider_requests",
          "max_billable_units",
          "billable_calls",
          "result_retention",
          "retry_policy"
        ],
        "properties": {
          "geo_request_fingerprint": {
            "$ref": "#/$defs/identity"
          },
          "operation": {
            "enum": [
              "resolve_place",
              "reverse_geocode",
              "nearby_places"
            ]
          },
          "coordinates": {
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "#/$defs/coordinate"
            }
          },
          "pending_logical_queries": {
            "type": "integer",
            "minimum": 0
          },
          "source_item_outcomes": {
            "type": "integer",
            "minimum": 0
          },
          "nearby_radius_meters": {
            "type": "integer",
            "minimum": 1
          },
          "max_places": {
            "type": "integer",
            "minimum": 1
          },
          "transmitted_data_classes": {
            "type": "array",
            "minItems": 0,
            "items": {
              "enum": [
                "coordinate",
                "datum",
                "locale"
              ]
            }
          },
          "providers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "data_handling"
              ],
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "data_handling": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "max_provider_requests": {
            "type": "integer",
            "minimum": 0
          },
          "max_billable_units": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "billable_calls": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "result_retention": {
            "const": "immutable_precheck_result"
          },
          "retry_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_attempts",
              "backoff_seconds",
              "coordinate_deadline_seconds"
            ],
            "properties": {
              "max_attempts": {
                "const": 3
              },
              "backoff_seconds": {
                "const": [
                  1,
                  3
                ]
              },
              "coordinate_deadline_seconds": {
                "const": 120
              }
            }
          },
          "execution_profile": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "identity",
                  "proxy_receivers",
                  "no_proxy_configured",
                  "ca_source",
                  "reachability",
                  "tls_verification",
                  "timing"
                ],
                "properties": {
                  "identity": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "proxy_receivers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "no_proxy_configured": {
                    "type": "boolean"
                  },
                  "ca_source": {
                    "enum": [
                      "system",
                      "configured_bundle"
                    ]
                  },
                  "reachability": {
                    "const": "not_checked"
                  },
                  "tls_verification": {
                    "const": true
                  },
                  "timing": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "routing": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "coordinate",
                "region",
                "provider_order",
                "required_provider",
                "basis"
              ],
              "properties": {
                "coordinate": {
                  "$ref": "#/$defs/coordinate"
                },
                "region": {
                  "enum": [
                    "mainland",
                    "overseas",
                    "uncertain"
                  ]
                },
                "provider_order": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "required_provider": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "basis": {
                  "type": "string"
                }
              }
            }
          },
          "recovery_of": {
            "type": "string",
            "pattern": "^request:[^\\s]+$"
          },
          "recovery_accounting": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "root_request_id",
                  "prior_request_id",
                  "prior_provider_requests",
                  "prior_provider_requests_upper_bound",
                  "prior_billable_units",
                  "cumulative_provider_request_ceiling",
                  "remaining_provider_request_budget"
                ],
                "properties": {
                  "root_request_id": {
                    "type": "string"
                  },
                  "prior_request_id": {
                    "type": "string"
                  },
                  "prior_provider_requests": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "prior_provider_requests_upper_bound": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "prior_billable_units": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "cumulative_provider_request_ceiling": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "remaining_provider_request_budget": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "prior_provider_requests": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "prior_billable_units": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "cumulative_provider_request_ceiling": {
            "type": "integer",
            "minimum": 1
          },
          "recovery_policy": {
            "type": "string",
            "minLength": 1
          },
          "original_logical_queries": {
            "type": "integer",
            "minimum": 1
          },
          "pending_components": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "coordinate",
                "operation"
              ],
              "properties": {
                "coordinate": {
                  "$ref": "#/$defs/coordinate"
                },
                "operation": {
                  "enum": [
                    "reverse_geocode",
                    "nearby_places"
                  ]
                }
              }
            }
          }
        }
      },
      "scope_confirmation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "inventory_fingerprint",
          "inventory"
        ],
        "properties": {
          "kind": {
            "const": "source_scope"
          },
          "inventory_fingerprint": {
            "$ref": "#/$defs/identity"
          },
          "inventory": {
            "$ref": "#/$defs/scope_inventory"
          }
        }
      },
      "effect_confirmation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "content_identity",
          "summary"
        ],
        "properties": {
          "kind": {
            "const": "external_effect"
          },
          "content_identity": {
            "$ref": "#/$defs/identity"
          },
          "disclosure": {
            "$ref": "#/$defs/disclosure"
          },
          "page": {
            "$ref": "#/$defs/page"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "disclosure"
              ]
            },
            "then": {
              "required": [
                "page"
              ]
            }
          }
        ]
      },
      "confirmation": {
        "oneOf": [
          {
            "$ref": "#/$defs/scope_confirmation"
          },
          {
            "$ref": "#/$defs/effect_confirmation"
          }
        ]
      },
      "running": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "progress",
          "allowed_actions"
        ],
        "properties": {
          "issues": {
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "#/$defs/issue"
            },
            "maxItems": 5
          },
          "issues_truncated": {
            "const": true
          },
          "accounting": {
            "$ref": "#/$defs/accounting_run"
          },
          "diagnostics": {
            "$ref": "#/$defs/diagnostics"
          },
          "state": {
            "const": "running"
          },
          "progress": {
            "$ref": "#/$defs/progress"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "allowed_actions": {
            "$ref": "#/$defs/controls"
          }
        }
      },
      "paused": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "reason",
          "allowed_actions"
        ],
        "properties": {
          "issues": {
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "#/$defs/issue"
            },
            "maxItems": 5
          },
          "issues_truncated": {
            "const": true
          },
          "accounting": {
            "$ref": "#/$defs/accounting_run"
          },
          "diagnostics": {
            "$ref": "#/$defs/diagnostics"
          },
          "state": {
            "const": "paused"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "allowed_actions": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "enum": [
                "resume",
                "cancel"
              ]
            }
          },
          "confirmation": {
            "$ref": "#/$defs/confirmation"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "reason": {
                  "properties": {
                    "code": {
                      "enum": [
                        "confirmation_required",
                        "scope_confirmation_required"
                      ]
                    }
                  }
                }
              }
            },
            "then": {
              "required": [
                "confirmation"
              ]
            }
          }
        ]
      },
      "blocked": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "reason",
          "allowed_actions"
        ],
        "properties": {
          "issues": {
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "#/$defs/issue"
            },
            "maxItems": 5
          },
          "issues_truncated": {
            "const": true
          },
          "accounting": {
            "$ref": "#/$defs/accounting_run"
          },
          "diagnostics": {
            "$ref": "#/$defs/diagnostics"
          },
          "state": {
            "const": "blocked"
          },
          "reason": {
            "allOf": [
              {
                "$ref": "#/$defs/reason"
              },
              {
                "required": [
                  "resume_when"
                ]
              }
            ]
          },
          "allowed_actions": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "enum": [
                "resume",
                "cancel"
              ]
            }
          }
        }
      },
      "completed": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "result"
        ],
        "properties": {
          "issues": {
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "#/$defs/issue"
            },
            "maxItems": 5
          },
          "issues_truncated": {
            "const": true
          },
          "accounting": {
            "$ref": "#/$defs/accounting_run"
          },
          "diagnostics": {
            "$ref": "#/$defs/diagnostics"
          },
          "state": {
            "const": "completed"
          },
          "result": {
            "$ref": "#/$defs/result"
          }
        }
      },
      "failed": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "reason"
        ],
        "properties": {
          "issues": {
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "#/$defs/issue"
            },
            "maxItems": 5
          },
          "issues_truncated": {
            "const": true
          },
          "accounting": {
            "$ref": "#/$defs/accounting_run"
          },
          "diagnostics": {
            "$ref": "#/$defs/diagnostics"
          },
          "state": {
            "const": "failed"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          }
        }
      },
      "cancelled": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state"
        ],
        "properties": {
          "issues": {
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "#/$defs/issue"
            },
            "maxItems": 5
          },
          "issues_truncated": {
            "const": true
          },
          "accounting": {
            "$ref": "#/$defs/accounting_run"
          },
          "diagnostics": {
            "$ref": "#/$defs/diagnostics"
          },
          "state": {
            "const": "cancelled"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          }
        }
      },
      "control": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "$ref": "#/$defs/state"
          }
        }
      },
      "started": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_ref"
        ],
        "properties": {
          "run_ref": {
            "$ref": "#/$defs/run_ref"
          }
        }
      }
    }
  },
  "responseSchemas": {
    "start": {
      "oneOf": [
        {
          "$ref": "#/$defs/started"
        },
        {
          "$ref": "#/$defs/error_response"
        }
      ]
    },
    "status": {
      "oneOf": [
        {
          "$ref": "#/$defs/running"
        },
        {
          "$ref": "#/$defs/paused"
        },
        {
          "$ref": "#/$defs/blocked"
        },
        {
          "$ref": "#/$defs/completed"
        },
        {
          "$ref": "#/$defs/cancelled"
        },
        {
          "$ref": "#/$defs/failed"
        },
        {
          "$ref": "#/$defs/error_response"
        }
      ]
    },
    "pause": {
      "oneOf": [
        {
          "$ref": "#/$defs/control"
        },
        {
          "$ref": "#/$defs/error_response"
        }
      ]
    },
    "resume": {
      "oneOf": [
        {
          "$ref": "#/$defs/control"
        },
        {
          "$ref": "#/$defs/error_response"
        }
      ]
    },
    "cancel": {
      "oneOf": [
        {
          "$ref": "#/$defs/control"
        },
        {
          "$ref": "#/$defs/error_response"
        }
      ]
    }
  }
}
