{
  "contract": "mediasense.plan-skill-geo-fixtures",
  "version": 1,
  "scenarios": [
    {
      "id": "existing_place_evidence_is_enough",
      "covers": ["prefer_existing_evidence", "stop_condition"],
      "prompt": "The bound Result already identifies the venue clearly enough to name this group.",
      "tool_route": [],
      "must": ["Use the existing Result evidence", "Perform no live Geo request"],
      "must_not": ["Repeat provider work", "Treat more lookup as automatically better"]
    },
    {
      "id": "authorized_resolve_place",
      "covers": ["geo_preflight", "exact_authorization", "plan_owned_observation"],
      "prompt": "The Result has one exact coordinate but no place candidate, and a venue could materially improve the Plan name.",
      "tool_route": [
        {
          "tool": "mediasense.plan.work",
          "request": {
            "action": "enrich_geo",
            "work_ref": "plan-work:example",
            "base_revision": "work-revision:r1",
            "request_id": "request:plan-geo-1",
            "geo_request": {
              "request_id": "request:geo-1",
              "operation": "resolve_place",
              "subjects": [
                {
                  "subject_ref": "source-item:photo-1",
                  "coordinate": {
                    "latitude": 31.1434,
                    "longitude": 121.6579,
                    "datum": "WGS84"
                  }
                }
              ],
              "locale": "zh-CN",
              "retention": "caller_state"
            }
          }
        }
      ],
      "must": ["Show the exact proposed effects", "Use trusted Human authorization", "Reinspect the returned Plan revision"],
      "must_not": ["Send media or paths", "Promote the provider candidate to confirmed place truth"]
    },
    {
      "id": "nearby_places_needs_more_authority",
      "covers": ["bounded_continuation", "authorization_delta"],
      "prompt": "resolve_place returned a broad district and nearby-place evidence could distinguish two plausible venues.",
      "tool_route": [
        {
          "tool": "mediasense.plan.work",
          "request": {
            "action": "enrich_geo",
            "work_ref": "plan-work:example",
            "base_revision": "work-revision:r2",
            "request_id": "request:plan-geo-2",
            "geo_request": {
              "request_id": "request:geo-2",
              "operation": "nearby_places",
              "subjects": [
                {
                  "subject_ref": "source-item:photo-1",
                  "coordinate": {
                    "latitude": 31.1434,
                    "longitude": 121.6579,
                    "datum": "WGS84"
                  }
                }
              ],
              "locale": "zh-CN",
              "radius_meters": 500,
              "max_places": 10,
              "retention": "caller_state"
            }
          }
        }
      ],
      "must": ["Explain the additional effect", "Obtain authority for the continuation", "Preserve conflicting candidates"],
      "must_not": ["Reuse broader authority silently", "Expose provider-native response fields"]
    },
    {
      "id": "human_refuses_geo",
      "covers": ["refusal", "zero_effect", "usable_fallback"],
      "prompt": "The Human does not permit the coordinate to leave the device.",
      "tool_route": [],
      "must": ["Continue with existing evidence or ask the Human directly", "Report zero provider requests"],
      "must_not": ["Retry another provider", "Call a provider directly", "Claim that no place exists"]
    },
    {
      "id": "coordinate_missing_or_conflicting",
      "covers": ["precheck_reopen", "stage_boundary"],
      "prompt": "The relevant Source Item has no usable coordinate or the Result contains conflicting coordinate observations.",
      "tool_route": [],
      "must": ["Expose the upstream evidence gap", "Reopen PreCheck when the decision depends on it"],
      "must_not": ["Invent a coordinate", "Read PreCheck SQLite", "Send media to a map provider"]
    }
  ]
}
