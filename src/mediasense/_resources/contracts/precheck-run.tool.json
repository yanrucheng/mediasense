{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mediasense:tool:precheck-run",
  "name": "mediasense.precheck.run",
  "description": "Manage one mutable, durable PreCheck Working Run, report observable execution activity, and report automatic immutable Result publication without exposing private working records.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:mediasense:tool:precheck-run-input",
    "oneOf": [
      { "$ref": "#/$defs/start_request" },
      { "$ref": "#/$defs/status_request" },
      { "$ref": "#/$defs/pause_request" },
      { "$ref": "#/$defs/resume_request" },
      { "$ref": "#/$defs/cancel_request" }
    ],
    "$defs": {
      "dataset_ref": {
        "type": "string",
        "pattern": "^dataset:[^\\s]+$"
      },
      "result_ref": {
        "type": "string",
        "pattern": "^precheck-result:[^\\s]+$"
      },
      "run_ref": {
        "type": "string",
        "pattern": "^precheck-run:[^\\s]+$"
      },
      "request_id": {
        "type": "string",
        "pattern": "^request:[^\\s]+$"
      },
      "external_effect_decision": {
        "enum": ["proceed", "decline"]
      },
      "source_scope_selection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "inventory_fingerprint",
          "default_disposition",
          "exceptions"
        ],
        "properties": {
          "kind": { "const": "source_scope" },
          "inventory_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "default_disposition": { "enum": ["include", "exclude"] },
          "exceptions": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "confirmation_decision": {
        "oneOf": [
          { "$ref": "#/$defs/external_effect_decision" },
          { "$ref": "#/$defs/source_scope_selection" }
        ]
      },
      "start_request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "request_id"],
        "properties": {
          "action": { "const": "start" },
          "dataset_ref": { "$ref": "#/$defs/dataset_ref" },
          "prior_result_ref": { "$ref": "#/$defs/result_ref" },
          "request_id": { "$ref": "#/$defs/request_id" }
        },
        "oneOf": [
          { "required": ["dataset_ref"] },
          { "required": ["prior_result_ref"] }
        ]
      },
      "status_request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "run_ref"],
        "properties": {
          "action": { "const": "status" },
          "run_ref": { "$ref": "#/$defs/run_ref" },
          "scope_path": { "type": "string", "minLength": 1 },
          "scope_after": { "type": "string", "minLength": 1 }
        },
        "dependentRequired": {
          "scope_after": ["scope_path"]
        }
      },
      "pause_request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "run_ref"],
        "properties": {
          "action": { "const": "pause" },
          "run_ref": { "$ref": "#/$defs/run_ref" }
        }
      },
      "resume_request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "run_ref"],
        "properties": {
          "action": { "const": "resume" },
          "run_ref": { "$ref": "#/$defs/run_ref" },
          "decision": { "$ref": "#/$defs/confirmation_decision" }
        }
      },
      "cancel_request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "run_ref"],
        "properties": {
          "action": { "const": "cancel" },
          "run_ref": { "$ref": "#/$defs/run_ref" }
        }
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:mediasense:tool:precheck-run-output",
    "oneOf": [
      { "$ref": "#/$defs/start_response" },
      { "$ref": "#/$defs/running_status" },
      { "$ref": "#/$defs/paused_status" },
      { "$ref": "#/$defs/blocked_status" },
      { "$ref": "#/$defs/completed_status" },
      { "$ref": "#/$defs/cancelled_status" },
      { "$ref": "#/$defs/failed_status" },
      { "$ref": "#/$defs/pause_response" },
      { "$ref": "#/$defs/resume_response" },
      { "$ref": "#/$defs/cancel_response" },
      { "$ref": "#/$defs/error_response" }
    ],
    "$defs": {
      "dataset_ref": {
        "type": "string",
        "pattern": "^dataset:[^\\s]+$"
      },
      "result_ref": {
        "type": "string",
        "pattern": "^precheck-result:[^\\s]+$"
      },
      "run_ref": {
        "type": "string",
        "pattern": "^precheck-run:[^\\s]+$"
      },
      "public_state": {
        "enum": ["running", "paused", "blocked", "completed", "cancelled", "failed"]
      },
      "external_effect_decision": {
        "enum": ["proceed", "decline"]
      },
      "source_scope_selection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "inventory_fingerprint",
          "default_disposition",
          "exceptions"
        ],
        "properties": {
          "kind": { "const": "source_scope" },
          "inventory_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "default_disposition": { "enum": ["include", "exclude"] },
          "exceptions": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "confirmation_decision": {
        "oneOf": [
          { "$ref": "#/$defs/external_effect_decision" },
          { "$ref": "#/$defs/source_scope_selection" }
        ]
      },
      "accepted_scope_selection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "inventory_fingerprint",
          "default_disposition",
          "exceptions",
          "provenance"
        ],
        "properties": {
          "kind": { "const": "source_scope" },
          "inventory_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "default_disposition": { "enum": ["include", "exclude"] },
          "exceptions": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "provenance": { "enum": ["accepted", "reused"] },
          "reused_from_run_ref": { "$ref": "#/$defs/run_ref" }
        }
      },
      "control_action": {
        "enum": ["pause", "resume", "cancel"]
      },
      "running_actions": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/control_action" },
        "allOf": [
          { "contains": { "const": "pause" }, "minContains": 1, "maxContains": 1 },
          { "contains": { "const": "cancel" }, "minContains": 1, "maxContains": 1 }
        ]
      },
      "resumable_actions": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/control_action" },
        "allOf": [
          { "contains": { "const": "resume" }, "minContains": 1, "maxContains": 1 },
          { "contains": { "const": "cancel" }, "minContains": 1, "maxContains": 1 }
        ]
      },
      "no_actions": {
        "type": "array",
        "maxItems": 0
      },
      "count_or_unknown": {
        "oneOf": [
          { "type": "integer", "minimum": 0 },
          { "const": "unknown" }
        ]
      },
      "execution_phase": {
        "enum": [
          "source_accounting",
          "scope_review",
          "metadata",
          "renditions",
          "video",
          "gpx",
          "embeddings",
          "sensitivity",
          "bundling",
          "compression",
          "external_evidence",
          "publishing",
          "complete",
          "unknown"
        ]
      },
      "activity_state": {
        "enum": [
          "working",
          "no_recent_progress",
          "suspected_stalled",
          "waiting",
          "paused",
          "finished"
        ]
      },
      "phase_work": {
        "type": "object",
        "additionalProperties": false,
        "required": ["completed", "reused", "failed", "remaining", "total"],
        "properties": {
          "completed": { "$ref": "#/$defs/count_or_unknown" },
          "reused": { "$ref": "#/$defs/count_or_unknown" },
          "failed": { "$ref": "#/$defs/count_or_unknown" },
          "remaining": { "$ref": "#/$defs/count_or_unknown" },
          "total": { "$ref": "#/$defs/count_or_unknown" }
        }
      },
      "error_phase_summary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "count"],
        "properties": {
          "phase": { "$ref": "#/$defs/execution_phase" },
          "count": { "type": "integer", "minimum": 1 }
        }
      },
      "error_summary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["total", "by_phase", "truncated"],
        "properties": {
          "total": { "type": "integer", "minimum": 0 },
          "by_phase": {
            "type": "array",
            "maxItems": 5,
            "items": { "$ref": "#/$defs/error_phase_summary" }
          },
          "truncated": { "type": "boolean" }
        }
      },
      "activity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "phase", "work", "last_progress_at", "errors"],
        "properties": {
          "state": { "$ref": "#/$defs/activity_state" },
          "phase": { "$ref": "#/$defs/execution_phase" },
          "work": { "$ref": "#/$defs/phase_work" },
          "last_progress_at": {
            "anyOf": [
              { "type": "string", "format": "date-time" },
              { "const": "unknown" }
            ]
          },
          "errors": { "$ref": "#/$defs/error_summary" }
        }
      },
      "progress": {
        "type": "object",
        "additionalProperties": false,
        "required": ["discovered", "accounted", "usable", "exceptional", "unresolved"],
        "properties": {
          "discovered": { "$ref": "#/$defs/count_or_unknown" },
          "accounted": { "$ref": "#/$defs/count_or_unknown" },
          "usable": { "$ref": "#/$defs/count_or_unknown" },
          "exceptional": { "$ref": "#/$defs/count_or_unknown" },
          "unresolved": { "$ref": "#/$defs/count_or_unknown" }
        }
      },
      "reason": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "message": { "type": "string", "minLength": 1 },
          "resume_when": { "type": "string", "minLength": 1 }
        }
      },
      "kind_count": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "count"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 1 }
        }
      },
      "size_bucket": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bucket", "count"],
        "properties": {
          "bucket": {
            "enum": [
              "unknown",
              "zero",
              "under_1_mib",
              "1_to_10_mib",
              "10_to_100_mib",
              "100_mib_or_more"
            ]
          },
          "count": { "type": "integer", "minimum": 1 }
        }
      },
      "scope_tree_node": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "name",
          "node_type",
          "file_count",
          "byte_count",
          "unknown_size_count",
          "kind_counts",
          "size_buckets",
          "representative_paths",
          "children",
          "omitted_children"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "node_type": { "enum": ["directory", "file"] },
          "file_count": { "type": "integer", "minimum": 0 },
          "byte_count": { "type": "integer", "minimum": 0 },
          "unknown_size_count": { "type": "integer", "minimum": 0 },
          "kind_counts": {
            "type": "array",
            "items": { "$ref": "#/$defs/kind_count" }
          },
          "size_buckets": {
            "type": "array",
            "items": { "$ref": "#/$defs/size_bucket" }
          },
          "representative_paths": {
            "type": "array",
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1 }
          },
          "children": {
            "type": "array",
            "maxItems": 63,
            "items": { "$ref": "#/$defs/scope_tree_node" }
          },
          "omitted_children": { "type": "integer", "minimum": 0 }
        }
      },
      "scope_issue": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "code", "blocked", "basis"],
        "properties": {
          "relative_path": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 1 },
          "blocked": { "type": "boolean" },
          "basis": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "scope_inventory": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inventory_fingerprint",
          "scan_generation",
          "complete",
          "view",
          "issues"
        ],
        "properties": {
          "inventory_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "scan_generation": { "type": "integer", "minimum": 1 },
          "complete": { "type": "boolean" },
          "view": {
            "type": "object",
            "additionalProperties": false,
            "required": ["root", "max_depth", "max_nodes", "tree"],
            "properties": {
              "root": { "type": "string", "minLength": 1 },
              "max_depth": { "type": "integer", "minimum": 1 },
              "max_nodes": { "type": "integer", "minimum": 2 },
              "tree": { "$ref": "#/$defs/scope_tree_node" },
              "next_after": { "type": "string", "minLength": 1 }
            }
          },
          "issues": {
            "type": "object",
            "additionalProperties": false,
            "required": ["count", "representative", "truncated"],
            "properties": {
              "count": { "type": "integer", "minimum": 0 },
              "representative": {
                "type": "array",
                "maxItems": 3,
                "items": { "$ref": "#/$defs/scope_issue" }
              },
              "truncated": { "type": "boolean" }
            }
          }
        }
      },
      "external_effect_confirmation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "summary", "quantity", "unit", "skip_allowed", "content_identity", "disclosure"],
        "properties": {
          "kind": { "const": "external_effect" },
          "summary": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "skip_allowed": { "const": false },
          "content_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "disclosure": { "type": "object", "minProperties": 1 },
          "accepted_authority": { "type": "object", "minProperties": 3 }
        }
      },
      "source_scope_confirmation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "summary",
          "inventory_fingerprint",
          "scan_generation",
          "inventory"
        ],
        "properties": {
          "kind": { "const": "source_scope" },
          "summary": { "type": "string", "minLength": 1 },
          "inventory_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "scan_generation": { "type": "integer", "minimum": 1 },
          "inventory": { "$ref": "#/$defs/scope_inventory" }
        }
      },
      "confirmation": {
        "oneOf": [
          { "$ref": "#/$defs/external_effect_confirmation" },
          { "$ref": "#/$defs/source_scope_confirmation" }
        ]
      },
      "published_result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_ref", "coverage", "readiness", "integrity"],
        "properties": {
          "result_ref": { "$ref": "#/$defs/result_ref" },
          "coverage": { "enum": ["complete", "partial"] },
          "readiness": { "enum": ["plan_ready", "blocked"] },
          "integrity": { "const": "valid" }
        }
      },
      "start_response": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome", "action", "run_ref", "dataset_ref", "state"],
        "properties": {
          "outcome": { "const": "ok" },
          "action": { "const": "start" },
          "run_ref": { "$ref": "#/$defs/run_ref" },
          "dataset_ref": { "$ref": "#/$defs/dataset_ref" },
          "prior_result_ref": { "$ref": "#/$defs/result_ref" },
          "state": { "const": "running" }
        }
      },
      "status_base": {
        "type": "object",
        "required": [
          "outcome",
          "action",
          "run_ref",
          "dataset_ref",
          "state",
          "progress",
          "activity",
          "allowed_actions"
        ],
        "properties": {
          "outcome": { "const": "ok" },
          "action": { "const": "status" },
          "run_ref": { "$ref": "#/$defs/run_ref" },
          "dataset_ref": { "$ref": "#/$defs/dataset_ref" },
          "prior_result_ref": { "$ref": "#/$defs/result_ref" },
          "state": { "$ref": "#/$defs/public_state" },
          "progress": { "$ref": "#/$defs/progress" },
          "activity": { "$ref": "#/$defs/activity" },
          "scope_selection": { "$ref": "#/$defs/accepted_scope_selection" },
          "allowed_actions": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/control_action" }
          }
        }
      },
      "running_status": {
        "allOf": [
          { "$ref": "#/$defs/status_base" },
          {
            "oneOf": [
              {
                "type": "object",
                "required": ["state", "allowed_actions"],
                "properties": {
                  "state": { "const": "running" },
                  "activity": {
                    "allOf": [
                      { "$ref": "#/$defs/activity" },
                      {
                        "properties": {
                          "state": {
                            "enum": ["working", "no_recent_progress"]
                          }
                        }
                      }
                    ]
                  },
                  "allowed_actions": { "$ref": "#/$defs/running_actions" }
                }
              },
              {
                "type": "object",
                "required": ["state", "allowed_actions", "reason"],
                "properties": {
                  "state": { "const": "running" },
                  "activity": {
                    "allOf": [
                      { "$ref": "#/$defs/activity" },
                      { "properties": { "state": { "const": "suspected_stalled" } } }
                    ]
                  },
                  "allowed_actions": { "$ref": "#/$defs/resumable_actions" },
                  "reason": { "$ref": "#/$defs/reason" }
                }
              }
            ]
          }
        ],
        "unevaluatedProperties": false
      },
      "paused_status": {
        "allOf": [
          { "$ref": "#/$defs/status_base" },
          {
            "type": "object",
            "required": ["state", "allowed_actions", "reason"],
            "properties": {
              "state": { "const": "paused" },
              "activity": {
                "allOf": [
                  { "$ref": "#/$defs/activity" },
                  {
                    "properties": {
                      "state": { "enum": ["waiting", "paused"] }
                    }
                  }
                ]
              },
              "allowed_actions": { "$ref": "#/$defs/resumable_actions" },
              "reason": { "$ref": "#/$defs/reason" },
              "confirmation": { "$ref": "#/$defs/confirmation" }
            }
          },
          {
            "if": {
              "properties": {
                "reason": {
                  "properties": {
                    "code": {
                      "enum": [
                        "confirmation_required",
                        "scope_confirmation_required"
                      ]
                    }
                  },
                  "required": ["code"]
                }
              },
              "required": ["reason"]
            },
            "then": { "required": ["confirmation"] },
            "else": { "properties": { "confirmation": false } }
          }
        ],
        "unevaluatedProperties": false
      },
      "blocked_status": {
        "allOf": [
          { "$ref": "#/$defs/status_base" },
          {
            "type": "object",
            "required": ["state", "allowed_actions", "reason"],
            "properties": {
              "state": { "const": "blocked" },
              "activity": {
                "allOf": [
                  { "$ref": "#/$defs/activity" },
                  { "properties": { "state": { "const": "waiting" } } }
                ]
              },
              "allowed_actions": { "$ref": "#/$defs/resumable_actions" },
              "reason": { "$ref": "#/$defs/reason" }
            }
          }
        ],
        "unevaluatedProperties": false
      },
      "completed_status": {
        "allOf": [
          { "$ref": "#/$defs/status_base" },
          {
            "type": "object",
            "required": ["state", "allowed_actions", "published_result"],
            "properties": {
              "state": { "const": "completed" },
              "activity": {
                "allOf": [
                  { "$ref": "#/$defs/activity" },
                  {
                    "properties": {
                      "state": { "const": "finished" },
                      "phase": { "const": "complete" }
                    }
                  }
                ]
              },
              "allowed_actions": { "$ref": "#/$defs/no_actions" },
              "progress": {
                "allOf": [
                  { "$ref": "#/$defs/progress" },
                  {
                    "properties": {
                      "accounted": { "type": "integer", "minimum": 0 }
                    }
                  }
                ]
              },
              "published_result": { "$ref": "#/$defs/published_result" }
            }
          }
        ],
        "unevaluatedProperties": false
      },
      "cancelled_status": {
        "allOf": [
          { "$ref": "#/$defs/status_base" },
          {
            "type": "object",
            "required": ["state", "allowed_actions"],
            "properties": {
              "state": { "const": "cancelled" },
              "activity": {
                "allOf": [
                  { "$ref": "#/$defs/activity" },
                  { "properties": { "state": { "const": "finished" } } }
                ]
              },
              "allowed_actions": { "$ref": "#/$defs/no_actions" },
              "reason": { "$ref": "#/$defs/reason" }
            }
          }
        ],
        "unevaluatedProperties": false
      },
      "failed_status": {
        "allOf": [
          { "$ref": "#/$defs/status_base" },
          {
            "type": "object",
            "required": ["state", "allowed_actions", "reason"],
            "properties": {
              "state": { "const": "failed" },
              "activity": {
                "allOf": [
                  { "$ref": "#/$defs/activity" },
                  { "properties": { "state": { "const": "finished" } } }
                ]
              },
              "allowed_actions": { "$ref": "#/$defs/no_actions" },
              "reason": { "$ref": "#/$defs/reason" }
            }
          }
        ],
        "unevaluatedProperties": false
      },
      "pause_response": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome", "action", "run_ref", "observed_state", "target_state"],
        "properties": {
          "outcome": { "const": "accepted" },
          "action": { "const": "pause" },
          "run_ref": { "$ref": "#/$defs/run_ref" },
          "observed_state": { "$ref": "#/$defs/public_state" },
          "target_state": { "const": "paused" }
        }
      },
      "resume_response": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome", "action", "run_ref", "observed_state", "target_state"],
        "properties": {
          "outcome": { "const": "accepted" },
          "action": { "const": "resume" },
          "run_ref": { "$ref": "#/$defs/run_ref" },
          "decision": { "$ref": "#/$defs/confirmation_decision" },
          "observed_state": { "$ref": "#/$defs/public_state" },
          "target_state": { "enum": ["running", "cancelled"] }
        }
      },
      "cancel_response": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome", "action", "run_ref", "observed_state", "target_state"],
        "properties": {
          "outcome": { "const": "accepted" },
          "action": { "const": "cancel" },
          "run_ref": { "$ref": "#/$defs/run_ref" },
          "observed_state": { "$ref": "#/$defs/public_state" },
          "target_state": { "const": "cancelled" }
        }
      },
      "error_response": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome", "action", "error"],
        "properties": {
          "outcome": { "const": "error" },
          "action": { "enum": ["start", "status", "pause", "resume", "cancel"] },
          "run_ref": { "$ref": "#/$defs/run_ref" },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {
                "enum": [
                  "invalid_request",
                  "dataset_not_found",
                  "result_not_found",
                  "result_untrusted",
                  "run_not_found",
                  "invalid_state",
                  "idempotency_conflict",
                  "access_denied",
                  "operation_failed",
                  "authorization_required"
                ]
              },
              "message": { "type": "string", "minLength": 1 },
              "current_state": { "$ref": "#/$defs/public_state" },
              "allowed_actions": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/control_action" }
              }
            }
          }
        }
      }
    }
  }
}
