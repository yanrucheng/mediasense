{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mediasense:tool:precheck-read",
  "name": "mediasense.precheck.read",
  "description": "Review, expand, or exactly resolve one immutable PreCheck Result without exposing stage-private storage.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:mediasense:tool:precheck-read:input",
    "oneOf": [
      { "$ref": "#/$defs/review_request" },
      { "$ref": "#/$defs/expand_request" },
      { "$ref": "#/$defs/resolve_request" }
    ],
    "$defs": {
      "opaque_ref": {
        "type": "string",
        "minLength": 1
      },
      "page_100": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
          "cursor": { "type": "string", "minLength": 1 }
        }
      },
      "page_200": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "cursor": { "type": "string", "minLength": 1 }
        }
      },
      "page_1000": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 250 },
          "cursor": { "type": "string", "minLength": 1 }
        }
      },
      "explicit_set": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "source_item_refs"],
        "properties": {
          "kind": { "const": "explicit" },
          "source_item_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/opaque_ref" }
          }
        }
      },
      "accounts_for_set": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "origin", "relation", "direction"],
        "properties": {
          "kind": { "const": "precheck_relation" },
          "origin": { "$ref": "#/$defs/opaque_ref" },
          "relation": { "const": "accounts_for" },
          "direction": { "const": "outbound" }
        }
      },
      "represents_set": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "origin", "relation", "direction"],
        "properties": {
          "kind": { "const": "precheck_relation" },
          "origin": { "$ref": "#/$defs/opaque_ref" },
          "relation": { "const": "represents" },
          "direction": { "const": "outbound" }
        }
      },
      "union_set": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "sets"],
        "properties": {
          "kind": { "const": "union" },
          "sets": {
            "type": "array",
            "minItems": 2,
            "items": { "$ref": "#/$defs/source_set" }
          }
        }
      },
      "difference_set": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "base", "subtract"],
        "properties": {
          "kind": { "const": "difference" },
          "base": { "$ref": "#/$defs/source_set" },
          "subtract": { "$ref": "#/$defs/source_set" }
        }
      },
      "source_set": {
        "oneOf": [
          { "$ref": "#/$defs/explicit_set" },
          { "$ref": "#/$defs/accounts_for_set" },
          { "$ref": "#/$defs/represents_set" },
          { "$ref": "#/$defs/union_set" },
          { "$ref": "#/$defs/difference_set" }
        ]
      },
      "review_request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "result_ref"],
        "properties": {
          "operation": { "const": "review" },
          "result_ref": { "$ref": "#/$defs/opaque_ref" },
          "page": { "$ref": "#/$defs/page_100" }
        }
      },
      "expand_request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "result_ref", "include"],
        "properties": {
          "operation": { "const": "expand" },
          "result_ref": { "$ref": "#/$defs/opaque_ref" },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/opaque_ref" }
          },
          "source_item_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/opaque_ref" }
          },
          "include": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "anchor_evidence",
                "prepared_targets",
                "provenance",
                "coverage_basis",
                "member_observations",
                "source_item",
                "observations",
                "covering_evidence"
              ]
            }
          },
          "page": { "$ref": "#/$defs/page_200" }
        },
        "oneOf": [
          { "required": ["evidence_refs"], "properties": { "source_item_refs": false } },
          { "required": ["source_item_refs"], "properties": { "evidence_refs": false } }
        ]
      },
      "resolve_request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "result_ref", "source_set"],
        "properties": {
          "operation": { "const": "resolve" },
          "result_ref": { "$ref": "#/$defs/opaque_ref" },
          "source_set": { "$ref": "#/$defs/source_set" },
          "page": { "$ref": "#/$defs/page_1000" }
        }
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:mediasense:tool:precheck-read:output",
    "oneOf": [
      { "$ref": "#/$defs/review_response" },
      { "$ref": "#/$defs/expand_response" },
      { "$ref": "#/$defs/resolve_response" },
      { "$ref": "#/$defs/error_response" }
    ],
    "$defs": {
      "opaque_ref": { "type": "string", "minLength": 1 },
      "json_value": {
        "oneOf": [
          { "type": "null" },
          { "type": "boolean" },
          { "type": "number" },
          { "type": "string" },
          { "type": "array", "items": { "$ref": "#/$defs/json_value" } },
          { "type": "object", "additionalProperties": { "$ref": "#/$defs/json_value" } }
        ]
      },
      "basis": { "$ref": "#/$defs/json_value" },
      "qualification": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "effect", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "effect": { "enum": ["limits_interpretation", "blocks_use"] },
          "message": { "type": "string", "minLength": 1 },
          "basis": { "$ref": "#/$defs/basis" }
        }
      },
      "observation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["available", "missing", "failed", "not_checked", "not_applicable"] },
          "value": { "$ref": "#/$defs/json_value" },
          "basis": { "$ref": "#/$defs/basis" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "qualifications": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/qualification" }
          }
        }
      },
      "source_locator": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "source_root_ref", "value"],
        "properties": {
          "kind": { "const": "source_root_relative_path" },
          "source_root_ref": { "$ref": "#/$defs/opaque_ref" },
          "value": { "type": "string", "minLength": 1 }
        }
      },
      "access": {
        "type": "object",
        "minProperties": 1
      },
      "execution_boundary": {
        "type": "object",
        "minProperties": 1
      },
      "result_view": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "dataset_ref", "coverage", "readiness", "integrity", "execution_boundary"],
        "properties": {
          "kind": { "const": "result" },
          "ref": { "$ref": "#/$defs/opaque_ref" },
          "dataset_ref": { "$ref": "#/$defs/opaque_ref" },
          "coverage": { "enum": ["complete", "partial"] },
          "readiness": { "enum": ["plan_ready", "blocked"] },
          "integrity": { "enum": ["valid", "invalid"] },
          "execution_boundary": { "$ref": "#/$defs/execution_boundary" },
          "qualifications": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/qualification" }
          }
        }
      },
      "source_item_view": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "locator"],
        "properties": {
          "kind": { "const": "source_item" },
          "ref": { "$ref": "#/$defs/opaque_ref" },
          "locator": { "$ref": "#/$defs/source_locator" },
          "observations": {
            "type": "array",
            "items": { "$ref": "#/$defs/observation" }
          },
          "qualifications": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/qualification" }
          }
        }
      },
      "source_item_summary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "locator"],
        "properties": {
          "kind": { "const": "source_item" },
          "ref": { "$ref": "#/$defs/opaque_ref" },
          "locator": { "$ref": "#/$defs/source_locator" },
          "qualifications": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/qualification" }
          }
        }
      },
      "evidence_detail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "access", "roles"],
        "properties": {
          "kind": { "const": "evidence" },
          "ref": { "$ref": "#/$defs/opaque_ref" },
          "access": { "$ref": "#/$defs/access" },
          "observations": {
            "type": "array",
            "items": { "$ref": "#/$defs/observation" }
          },
          "qualifications": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/qualification" }
          },
          "roles": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/evidence_role" }
          }
        }
      },
      "evidence_role": {
        "enum": ["representative", "boundary", "outlier", "conflict"]
      },
      "status_counts": {
        "type": "object",
        "additionalProperties": false,
        "required": ["available", "missing", "failed", "not_checked", "not_applicable", "unreported"],
        "properties": {
          "available": { "type": "integer", "minimum": 0 },
          "missing": { "type": "integer", "minimum": 0 },
          "failed": { "type": "integer", "minimum": 0 },
          "not_checked": { "type": "integer", "minimum": 0 },
          "not_applicable": { "type": "integer", "minimum": 0 },
          "unreported": { "type": "integer", "minimum": 0 }
        }
      },
      "page": {
        "type": "object",
        "additionalProperties": false,
        "required": ["returned", "total", "complete", "stop_reason"],
        "properties": {
          "order": { "const": "frontier_order" },
          "returned": { "type": "integer", "minimum": 0 },
          "total": { "type": "integer", "minimum": 0 },
          "complete": { "type": "boolean" },
          "stop_reason": { "enum": ["complete", "limit", "byte_limit"] },
          "next_cursor": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "complete": { "const": false } }, "required": ["complete"] },
            "then": { "required": ["next_cursor"] },
            "else": { "properties": { "next_cursor": false } }
          }
        ]
      },
      "source_set": {
        "type": "object",
        "minProperties": 2
      },
      "reconciliation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accounted_total", "partition", "frontier", "exception_routes", "closure_check"],
        "properties": {
          "accounted_total": { "type": "integer", "minimum": 0 },
          "partition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frontier_only", "exception_only", "frontier_and_exception", "residual"],
            "properties": {
              "frontier_only": { "type": "integer", "minimum": 0 },
              "exception_only": { "type": "integer", "minimum": 0 },
              "frontier_and_exception": { "type": "integer", "minimum": 0 },
              "residual": { "type": "integer", "minimum": 0 }
            }
          },
          "frontier": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entry_evidence_count", "coverage_memberships", "represented_unique_source_items", "overlap_count"],
            "properties": {
              "entry_evidence_count": { "type": "integer", "minimum": 0 },
              "coverage_memberships": { "type": "integer", "minimum": 0 },
              "represented_unique_source_items": { "type": "integer", "minimum": 0 },
              "overlap_count": { "type": "integer", "minimum": 0 }
            }
          },
          "exception_routes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scope", "condition", "count"],
              "properties": {
                "scope": { "enum": ["source_media", "auxiliary", "excluded"] },
                "condition": { "enum": ["usable", "unsupported", "invalid", "error", "unresolved"] },
                "count": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "closure_check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "equation"],
            "properties": {
              "status": { "enum": ["passed", "partial"] },
              "equation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["left", "right"],
                "properties": {
                  "left": { "type": "integer", "minimum": 0 },
                  "right": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      },
      "coverage_card": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor_evidence_ref", "anchor_access", "represented", "projected_facts", "evidence_roles", "unassigned_prepared_evidence", "qualification_summary", "projection_scope", "available_expansions", "resolvable_source_set"],
        "properties": {
          "anchor_evidence_ref": { "$ref": "#/$defs/opaque_ref" },
          "anchor_access": { "$ref": "#/$defs/access" },
          "represented": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relationship", "membership_count", "unique_source_item_count", "scope_condition"],
            "properties": {
              "relationship": { "const": "represents" },
              "membership_count": { "type": "integer", "minimum": 0 },
              "unique_source_item_count": { "type": "integer", "minimum": 0 },
              "scope_condition": { "type": "array", "items": { "type": "object" } }
            }
          },
          "projected_facts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capture_time", "media_type"],
            "properties": {
              "capture_time": {
                "type": "object",
                "required": ["status_counts"],
                "properties": {
                  "status_counts": { "$ref": "#/$defs/status_counts" },
                  "earliest": { "type": "string", "format": "date-time" },
                  "latest": { "type": "string", "format": "date-time" }
                },
                "additionalProperties": false
              },
              "media_type": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status_counts", "values"],
                "properties": {
                  "status_counts": { "$ref": "#/$defs/status_counts" },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["value", "count"],
                      "properties": {
                        "value": { "type": "string", "minLength": 3 },
                        "count": { "type": "integer", "minimum": 1 }
                      }
                    }
                  }
                }
              }
            }
          },
          "evidence_roles": {
            "type": "object",
            "additionalProperties": false,
            "required": ["representative", "boundary", "outlier", "conflict"],
            "properties": {
              "representative": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/opaque_ref" } },
              "boundary": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/opaque_ref" } },
              "outlier": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/opaque_ref" } },
              "conflict": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/opaque_ref" } }
            }
          },
          "unassigned_prepared_evidence": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/opaque_ref" } },
          "qualification_summary": { "type": "array", "items": { "$ref": "#/$defs/qualification_summary" } },
          "projection_scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["projected_observations", "other_observations_available"],
            "properties": {
              "projected_observations": { "const": ["capture_time", "media_type", "evidence_role"] },
              "other_observations_available": { "type": "boolean" }
            }
          },
          "available_expansions": { "type": "array", "items": { "$ref": "#/$defs/available_expansion" } },
          "resolvable_source_set": { "$ref": "#/$defs/source_set" }
        }
      },
      "qualification_summary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["applies_to", "code", "effect", "message", "occurrences"],
        "properties": {
          "applies_to": { "enum": ["anchor_evidence", "prepared_evidence", "represents_member"] },
          "code": { "type": "string", "minLength": 1 },
          "effect": { "enum": ["limits_interpretation", "blocks_use"] },
          "message": { "type": "string", "minLength": 1 },
          "basis": { "$ref": "#/$defs/basis" },
          "occurrences": { "type": "integer", "minimum": 1 }
        }
      },
      "available_expansion": {
        "type": "object",
        "additionalProperties": false,
        "required": ["include", "estimated_items"],
        "properties": {
          "include": { "enum": ["anchor_evidence", "prepared_targets", "provenance", "coverage_basis", "member_observations"] },
          "estimated_items": { "type": "integer", "minimum": 0 }
        }
      },
      "review_response": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome", "operation", "result_ref", "result", "reconciliation", "coverage_cards", "page"],
        "properties": {
          "outcome": { "const": "ok" },
          "operation": { "const": "review" },
          "result_ref": { "$ref": "#/$defs/opaque_ref" },
          "result": { "$ref": "#/$defs/result_view" },
          "reconciliation": { "$ref": "#/$defs/reconciliation" },
          "coverage_cards": { "type": "array", "items": { "$ref": "#/$defs/coverage_card" } },
          "page": {
            "allOf": [
              { "$ref": "#/$defs/page" },
              { "required": ["order"] }
            ]
          }
        }
      },
      "prepared_target": {
        "type": "object",
        "required": ["target"],
        "properties": {
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": { "enum": ["source_item", "evidence"] },
              "ref": { "$ref": "#/$defs/opaque_ref" }
            }
          },
          "basis": { "$ref": "#/$defs/basis" },
          "qualifications": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/qualification" } },
          "roles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/evidence_role" } },
          "access_status": { "enum": ["available", "missing"] },
          "evidence_qualifications": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/qualification" } },
          "scope": { "enum": ["source_media", "auxiliary", "excluded"] },
          "condition": { "enum": ["usable", "unsupported", "invalid", "error", "unresolved"] }
        },
        "additionalProperties": false
      },
      "coverage_basis": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relationship", "member_count", "unqualified_member_count", "qualified_member_count", "qualification_groups", "member_specific_basis"],
        "properties": {
          "relationship": { "const": "represents" },
          "member_count": { "type": "integer", "minimum": 0 },
          "unqualified_member_count": { "type": "integer", "minimum": 0 },
          "qualified_member_count": { "type": "integer", "minimum": 0 },
          "qualification_groups": { "type": "array", "items": { "$ref": "#/$defs/qualification_count" } },
          "member_specific_basis": { "type": "boolean" }
        }
      },
      "qualification_count": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "effect", "message", "occurrences"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "effect": { "enum": ["limits_interpretation", "blocks_use"] },
          "message": { "type": "string", "minLength": 1 },
          "basis": { "$ref": "#/$defs/basis" },
          "occurrences": { "type": "integer", "minimum": 1 }
        }
      },
      "evidence_expansion_item": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor_evidence_ref", "included"],
        "properties": {
          "anchor_evidence_ref": { "$ref": "#/$defs/opaque_ref" },
          "included": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "anchor_evidence": { "$ref": "#/$defs/evidence_detail" },
              "prepared_targets": { "type": "array", "items": { "$ref": "#/$defs/prepared_target" } },
              "provenance": { "type": "array", "items": { "$ref": "#/$defs/prepared_target" } },
              "coverage_basis": { "$ref": "#/$defs/coverage_basis" }
            }
          }
        }
      },
      "member_observation_item": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor_evidence_ref", "source_item"],
        "properties": {
          "anchor_evidence_ref": { "$ref": "#/$defs/opaque_ref" },
          "source_item": { "$ref": "#/$defs/source_item_view" }
        }
      },
      "source_expansion_item": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_item_ref", "included"],
        "properties": {
          "source_item_ref": { "$ref": "#/$defs/opaque_ref" },
          "included": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_item": { "$ref": "#/$defs/source_item_summary" },
              "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
              "covering_evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["evidence_ref"],
                  "properties": {
                    "evidence_ref": { "$ref": "#/$defs/opaque_ref" },
                    "basis": { "$ref": "#/$defs/basis" },
                    "qualifications": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/qualification" } }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "expand_response": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome", "operation", "result_ref", "items", "page"],
        "properties": {
          "outcome": { "const": "ok" },
          "operation": { "const": "expand" },
          "result_ref": { "$ref": "#/$defs/opaque_ref" },
          "items": {
            "type": "array",
            "items": {
              "oneOf": [
                { "$ref": "#/$defs/evidence_expansion_item" },
                { "$ref": "#/$defs/member_observation_item" },
                { "$ref": "#/$defs/source_expansion_item" }
              ]
            }
          },
          "page": { "$ref": "#/$defs/page" }
        }
      },
      "source_verification": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": { "enum": ["available", "missing", "failed", "not_checked", "not_applicable"] },
          "profile": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "observed_at": { "type": "string", "format": "date-time" },
          "producer": { "type": "string", "minLength": 1 },
          "basis": { "$ref": "#/$defs/basis" },
          "qualifications": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/qualification" } }
        }
      },
      "resolved_member": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_item_ref", "locator", "scope", "condition", "source_content_verification"],
        "properties": {
          "source_item_ref": { "$ref": "#/$defs/opaque_ref" },
          "locator": { "$ref": "#/$defs/source_locator" },
          "scope": { "enum": ["source_media", "auxiliary", "excluded"] },
          "condition": { "enum": ["usable", "unsupported", "invalid", "error", "unresolved"] },
          "source_content_verification": { "$ref": "#/$defs/source_verification" },
          "qualifications": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/qualification" } }
        }
      },
      "resolve_response": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome", "operation", "result_ref", "resolution", "members", "page"],
        "properties": {
          "outcome": { "const": "ok" },
          "operation": { "const": "resolve" },
          "result_ref": { "$ref": "#/$defs/opaque_ref" },
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_set_identity", "membership_identity", "ordering", "total"],
            "properties": {
              "source_set_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "membership_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "ordering": { "const": "source_item_ref_ascending" },
              "total": { "type": "integer", "minimum": 0 }
            }
          },
          "members": { "type": "array", "items": { "$ref": "#/$defs/resolved_member" } },
          "page": { "$ref": "#/$defs/page" }
        }
      },
      "error_response": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome", "operation", "error"],
        "properties": {
          "outcome": { "const": "error" },
          "operation": { "enum": ["review", "expand", "resolve", "unknown"] },
          "result_ref": { "$ref": "#/$defs/opaque_ref" },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "retryable"],
            "properties": {
              "code": {
                "enum": [
                  "invalid_request",
                  "result_not_found",
                  "result_unavailable",
                  "result_untrusted",
                  "result_inconsistent",
                  "invalid_cursor",
                  "reference_not_in_result",
                  "unsupported_include",
                  "invalid_source_set",
                  "response_item_too_large"
                ]
              },
              "message": { "type": "string", "minLength": 1 },
              "retryable": { "type": "boolean" },
              "details": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
