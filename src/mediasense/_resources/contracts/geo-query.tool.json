{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mediasense:tool:geo-query",
  "name": "mediasense.geo.query",
  "description": "Return authorization-bound geographic candidate observations for exact coordinates without owning stage interpretation.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:mediasense:tool:geo-query-input",
    "type": "object",
    "additionalProperties": false,
    "required": ["request_id", "operation", "subjects", "locale"],
    "properties": {
      "request_id": {
        "type": "string",
        "pattern": "^request:[^\\s]+$"
      },
      "operation": {
        "enum": ["resolve_place", "reverse_geocode", "nearby_places"]
      },
      "subjects": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/subject" }
      },
      "locale": {
        "type": "string",
        "pattern": ".*\\S.*"
      },
      "radius_meters": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "Required for nearby_places; with max_places, expands resolve_place to include bounded nearby-place evidence."
      },
      "max_places": {
        "type": "integer",
        "minimum": 1,
        "description": "Required for nearby_places; with radius_meters, expands resolve_place to include bounded nearby-place evidence."
      },
      "retention": {
        "enum": ["none", "caller_state"],
        "default": "none"
      },
      "recovery": {
        "type": "object", "additionalProperties": false,
        "required": ["prior_request_id", "result_digest"],
        "properties": {
          "prior_request_id": { "type": "string", "pattern": "^request:[^\\s]+$" },
          "result_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      },
      "route_context": { "$ref": "#/$defs/route_context" }
    },
    "allOf": [
      {
        "if": {
          "properties": { "operation": { "const": "nearby_places" } },
          "required": ["operation"]
        },
        "then": { "required": ["radius_meters", "max_places"] }
      },
      {
        "if": {
          "anyOf": [
            { "required": ["radius_meters"] },
            { "required": ["max_places"] }
          ]
        },
        "then": {
          "required": ["radius_meters", "max_places"],
          "properties": {
            "operation": { "enum": ["resolve_place", "nearby_places"] }
          }
        }
      }
    ],
    "$defs": {
      "coordinate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["latitude", "longitude", "datum"],
        "properties": {
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "datum": { "enum": ["WGS84", "GCJ02"] }
        }
      },
      "subject": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_ref", "coordinate"],
        "properties": {
          "subject_ref": { "type": "string", "pattern": ".*\\S.*" },
          "coordinate": { "$ref": "#/$defs/coordinate" }
        }
      },
      "route_context": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "preferred_provider": { "type": ["string", "null"], "pattern": ".*\\S.*" },
          "locale": { "type": ["string", "null"], "pattern": ".*\\S.*" }
        }
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:mediasense:tool:geo-query-output",
    "oneOf": [
      { "$ref": "#/$defs/result" },
      { "$ref": "#/$defs/error" }
    ],
    "$defs": {
      "coordinate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["latitude", "longitude", "datum"],
        "properties": {
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "datum": { "enum": ["WGS84", "GCJ02"] }
        }
      },
      "qualification": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      },
      "candidate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "components"],
        "properties": {
          "kind": { "enum": ["address", "place"] },
          "name": { "type": "string", "minLength": 1 },
          "formatted_address": { "type": "string" },
          "coordinate": { "$ref": "#/$defs/coordinate" },
          "distance_meters": { "type": "number", "minimum": 0 },
          "components": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "provider_ref": { "type": "string", "minLength": 1 }
        }
      },
      "component": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "status", "subject_refs", "coordinate", "candidates", "qualifications"],
        "properties": {
          "operation": { "enum": ["reverse_geocode", "nearby_places"] },
          "observed_at": { "type": "string", "format": "date-time" },
          "status": { "enum": ["success", "no_result", "failed", "indeterminate", "not_requested"] },
          "subject_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "coordinate": { "$ref": "#/$defs/coordinate" },
          "candidates": {
            "type": "array",
            "items": { "$ref": "#/$defs/candidate" }
          },
          "qualifications": {
            "type": "array",
            "items": { "$ref": "#/$defs/qualification" }
          }
        }
      },
      "attempt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "operation", "status", "input_coordinate", "provider_coordinate", "provider_requests", "billable_units"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "operation": { "enum": ["resolve_place", "reverse_geocode", "nearby_places"] },
          "status": { "enum": ["success", "no_result", "failed", "indeterminate"] },
          "input_coordinate": { "$ref": "#/$defs/coordinate" },
          "provider_coordinate": { "anyOf": [{ "$ref": "#/$defs/coordinate" }, { "type": "null" }] },
          "request_count_kind": { "enum": ["exact", "reserved_upper_bound"], "default": "exact" },
          "execution_request_id": { "type": "string", "pattern": "^request:[^\\s]+$" },
          "observed_at": { "type": "string", "format": "date-time" },
          "provider_requests": { "type": "integer", "minimum": 0 },
          "billable_units": { "type": ["integer", "null"], "minimum": 0 },
          "error_code": { "type": "string" },
          "error_message": { "type": "string" },
          "retry_after_seconds": { "type": "number", "minimum": 0 }
        }
      },
      "effect_envelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["allowed_providers", "allowed_data_classes", "max_logical_queries", "max_provider_requests", "max_billable_units", "allow_unknown_billable_units", "retention"],
        "properties": {
          "allowed_providers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "allowed_data_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["coordinate", "datum", "locale"] }
          },
          "max_logical_queries": { "type": "integer", "minimum": 1 },
          "max_provider_requests": { "type": "integer", "minimum": 1 },
          "max_billable_units": { "type": ["integer", "null"], "minimum": 0 },
          "allow_unknown_billable_units": { "type": "boolean" },
          "retention": { "enum": ["none", "caller_state"] }
        }
      },
      "effects": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_queries", "provider_requests", "billable_units", "transmitted_data_classes", "providers_attempted"],
        "properties": {
          "logical_queries": { "type": "integer", "minimum": 0 },
          "provider_requests_upper_bound": { "type": "integer", "minimum": 0 },
          "provider_requests": { "type": ["integer", "null"], "minimum": 0 },
          "billable_units": { "type": ["integer", "null"], "minimum": 0 },
          "transmitted_data_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["coordinate", "datum", "locale"] }
          },
          "providers_attempted": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "continuation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "reason", "requires_authorization"],
        "properties": {
          "operation": { "enum": ["reverse_geocode", "nearby_places"] },
          "reason": { "type": "string", "minLength": 1 },
          "requires_authorization": { "type": "boolean" }
        }
      },
      "route_context": {
        "type": "object",
        "additionalProperties": false,
        "required": ["preferred_provider", "locale"],
        "properties": {
          "preferred_provider": { "type": ["string", "null"] },
          "locale": { "type": ["string", "null"] }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "request_id", "outcome", "operation", "request_fingerprint", "components", "attempts", "effects", "continuations", "observed_at", "qualifications", "route_context"],
        "properties": {
          "tool": { "const": "mediasense.geo.query" },
          "request_id": { "type": "string", "pattern": "^request:[^\\s]+$" },
          "outcome": { "enum": ["success", "partial", "no_result", "authorization_required", "unavailable", "failed", "indeterminate", "cancelled", "blocked"] },
          "operation": { "enum": ["resolve_place", "reverse_geocode", "nearby_places"] },
          "request_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
          "attempts": { "type": "array", "items": { "$ref": "#/$defs/attempt" } },
          "effects": { "$ref": "#/$defs/effects" },
          "continuations": { "type": "array", "items": { "$ref": "#/$defs/continuation" } },
          "observed_at": { "type": "string", "format": "date-time" },
          "qualifications": { "type": "array", "items": { "$ref": "#/$defs/qualification" } },
          "route_context": { "$ref": "#/$defs/route_context" },
          "recovery": {
            "type": "object", "additionalProperties": false,
            "required": ["root_request_id", "prior_request_id", "prior_provider_requests", "prior_provider_requests_upper_bound", "prior_billable_units", "cumulative_provider_request_ceiling", "remaining_provider_request_budget"],
            "properties": {
              "root_request_id": {"type":"string"}, "prior_request_id": {"type":"string"},
              "prior_provider_requests": {"type":["integer","null"],"minimum":0},
              "prior_provider_requests_upper_bound": {"type":["integer","null"],"minimum":0},
              "prior_billable_units": {"type":["integer","null"],"minimum":0},
              "cumulative_provider_request_ceiling": {"type":"integer","minimum":1},
              "remaining_provider_request_budget": {"type":["integer","null"],"minimum":0}
            }
          },
          "routing": {
            "type": "array", "items": {
              "type": "object", "additionalProperties": false,
              "required": ["coordinate", "region", "provider_order", "required_provider", "basis"],
              "properties": {
                "coordinate": { "$ref": "#/$defs/coordinate" },
                "region": { "enum": ["mainland", "overseas", "uncertain"] },
                "provider_order": { "type": "array", "items": { "type": "string" } },
                "required_provider": { "type": ["string", "null"] },
                "basis": { "type": "string" }
              }
            }
          },
          "execution_profile": {
            "type": "object", "additionalProperties": false,
            "required": ["identity", "proxy_receivers", "no_proxy_configured", "ca_source", "reachability", "tls_verification", "timing"],
            "properties": {
              "identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "proxy_receivers": { "type": "array", "items": { "type": "string" } },
              "no_proxy_configured": { "type": "boolean" },
              "ca_source": { "enum": ["system", "configured_bundle"] },
              "reachability": { "const": "not_checked" },
              "tls_verification": { "const": true },
              "timing": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } }
            }
          },
          "required_authorization": { "$ref": "#/$defs/effect_envelope" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "outcome": { "const": "authorization_required" } },
              "required": ["outcome"]
            },
            "then": { "required": ["required_authorization"] },
            "else": { "not": { "required": ["required_authorization"] } }
          }
        ]
      },
      "error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "outcome", "error"],
        "properties": {
          "tool": { "const": "mediasense.geo.query" },
          "request_id": { "type": "string", "pattern": "^request:[^\\s]+$" },
          "outcome": { "const": "error" },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "enum": ["invalid_request", "idempotency_conflict", "request_not_found", "recovery_stale", "recovery_unavailable", "execution_in_progress"] },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
